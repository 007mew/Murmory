# Environment Configuration Example for Murmory
# Note: Core capture, playback, and SQLite search work 100% offline without any keys.

# Optional Cloud AI / Transcription (Leave blank for pure offline operation)
MURMORY_TRANSCRIPTION_PROVIDER=offline # 'offline', 'whisper', 'gemini'
MURMORY_AI_API_KEY=

# Optional Cloud Sync (Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
